<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', flexDirection: 'column', fontFamily: '"Microsoft YaHei", Arial, sans-serif' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1F3A5F', lineHeight: 1.25 }}>数据库就藏在每天用的系统背后</Text>
    <Box style={{ height: 1, background: '#D8DEE6', marginTop: 12 }} />

    <Box style={{ flexDirection: 'row', gap: 40, marginTop: 28, height: 524 }}>
        <Box style={{ width: 360, background: '#1F3A5F', padding: 32, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>应用<br />场景</Text>
                <Box style={{ height: 1, background: '#FFFFFF', opacity: 0.4, marginTop: 18 }} />
                <Text style={{ fontSize: 20, color: '#FFFFFF', opacity: 0.88, lineHeight: 1.7, marginTop: 18 }}>下面这五个系统，背后都是一张张表在撑着。</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.8, lineHeight: 1.7 }}>共同点：数据要共享、要一致、要查得快，还要分权限。</Text>
        </Box>

        <Box style={{ width: 760, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', gap: 24, borderTop: '1px solid #D8DEE6', paddingTop: 16, paddingBottom: 16 }}>
                <Text style={{ width: 132, fontSize: 22, fontWeight: 'bold', color: '#22272E', lineHeight: 1.3 }}>教务系统</Text>
                <Text style={{ width: 600, fontSize: 18, color: '#5B6672', lineHeight: 1.6 }}>每学期的选课、成绩、学籍都在库里，几万条记录同时被人查。</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 24, borderTop: '1px solid #D8DEE6', paddingTop: 16, paddingBottom: 16 }}>
                <Text style={{ width: 132, fontSize: 22, fontWeight: 'bold', color: '#22272E', lineHeight: 1.3 }}>银行</Text>
                <Text style={{ width: 600, fontSize: 18, color: '#5B6672', lineHeight: 1.6 }}>转账要保证两边同时成功或同时失败，靠的是事务，不是人工核对。</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 24, borderTop: '1px solid #D8DEE6', paddingTop: 16, paddingBottom: 16 }}>
                <Text style={{ width: 132, fontSize: 22, fontWeight: 'bold', color: '#22272E', lineHeight: 1.3 }}>电商</Text>
                <Text style={{ width: 600, fontSize: 18, color: '#5B6672', lineHeight: 1.6 }}>商品、订单、库存分成不同的表，下单时一起校验、一起更新。</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 24, borderTop: '1px solid #D8DEE6', paddingTop: 16, paddingBottom: 16 }}>
                <Text style={{ width: 132, fontSize: 22, fontWeight: 'bold', color: '#22272E', lineHeight: 1.3 }}>微信</Text>
                <Text style={{ width: 600, fontSize: 18, color: '#5B6672', lineHeight: 1.6 }}>聊天记录、联系人、朋友圈按用户分开存，量太大就要分库分表。</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 24, borderTop: '1px solid #D8DEE6', borderBottom: '1px solid #D8DEE6', paddingTop: 16, paddingBottom: 16 }}>
                <Text style={{ width: 132, fontSize: 22, fontWeight: 'bold', color: '#22272E', lineHeight: 1.3 }}>图书馆</Text>
                <Text style={{ width: 600, fontSize: 18, color: '#5B6672', lineHeight: 1.6 }}>借还书记录谁借了什么、什么时候到期，一查就知道有没有逾期。</Text>
            </Box>
        </Box>
    </Box>

    <Text style={{ position: 'absolute', right: 60, bottom: 26, fontSize: 14, color: '#8A94A0' }}>04</Text>
</Slide>
